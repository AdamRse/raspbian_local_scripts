[Unit]
Description=Gestion de la lampe pour raspberry pi
After=network-online.target
Wants=network-online.target

[Service]
User=raspi
Group=raspi
Type=simple
ExecStart=h
Restart=on-failure
RestartSec=3600
StartLimitIntervalSec=86400
StartLimitBurst=4
WorkingDirectory=

[Install]
WantedBy=multi-user.target
